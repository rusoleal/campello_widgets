# Copied in by export_references.sh from the canonical source at
# tests/visual_fidelity/test_images/ — not committed, to avoid a second
# copy of the same binary drifting out of sync (same convention as iOS's
# bundle copy, which is also never committed).
android_fidelity_reference/app/src/main/res/drawable/liquid_glass_background.png

# windows_fidelity_reference/ is a WinUI 3 (.NET) project — its build
# artifacts are much larger than the other reference apps' (obj/ + bin/
# together run several hundred MB) and regenerate from export_references.ps1.
windows_fidelity_reference/bin/
windows_fidelity_reference/obj/
